        <mxCell id="note" value="组合器：节点 × 专家 token → 内容分数＋关系偏置 → 头轴 RMS → 两次收缩（含 ReLU）→ 残差／LayerNorm → 专家轴均值。&lt;br&gt;优化主模型后 EMA ← 0.99 × EMA ＋ 0.01 × 主编码。上传专家与组合器；预测器、RWSE 投影、适配器与 EMA 留在本地。&lt;br&gt;预测节点仍在输入中；这是潜表示预测，默认无 Top-K、无负边采样、无因素监督。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="mask" target="rel">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="290" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="server" name="B：合成探针上的输出与关系响应校准">
    <mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="900" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="B：合成探针上的输出与关系响应校准" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="1300" height="27" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="仅服务器内部计算，无真实客户端图和额外候选往返。只学习 K 个客户端聚合 logits，候选参数限制在上传模型的凸包。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#475569;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1340" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uploads" value="本轮 K 份上传&lt;br&gt;共享专家＋组合器" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="140" height="60" as="geometry" />
