        <mxCell id="ref" value="固定客户端参考&lt;br&gt;余弦读数 sᵢ 与响应 Rᵢ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="160" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mix" value="w = softmax(a)&lt;br&gt;θ(w) = Σᵢ wᵢ θᵢ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cand" value="候选共享模型&lt;br&gt;同一探针功能测试" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="400" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="measure" value="基准＋关系门控扰动&lt;br&gt;g = 1 ± εδ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="400" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="objective" value="固定参考加权误差&lt;br&gt;输出＋响应＋权重先验" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="400" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="adam" value="Adam 更新 a&lt;br&gt;默认 10 步" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="400" width="140" height="60" as="geometry" />
