        <mxCell id="final" value="组合后节点表示&lt;br&gt;adapter 可选残差" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="280" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="readout" value="节点：中心节点&lt;br&gt;图：整图均值池化" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="280" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="head" value="新任务头&lt;br&gt;训练／验证／测试" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
