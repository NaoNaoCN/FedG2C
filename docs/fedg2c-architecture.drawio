        <mxCell id="prompt" value="prompt：共享向量 p&lt;br&gt;零初始化，模式可选" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
