          <mxGeometry x="250" y="430" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mix" value="可选逐节点融合&lt;br&gt;α 本地＋(1−α)共享" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="430" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="input" target="experts">
