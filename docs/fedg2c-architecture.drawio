          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="s 是固定节点对的表示余弦相似度。R = [s(1＋εδ) − s(1−εδ)] / (2ε)，δ 在关系非零位置取单位范数方向。&lt;br&gt;正负扰动固定专家输出、边和特征，只改变组合器关系偏置门控；不是增删边或语义因素干预。&lt;br&gt;对照：fedavg（均匀平均）、output_only（只匹配输出）、response（输出＋响应）。真实组合泛化仍待验证。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1300" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="target" name="C：冻结原共享基座，目标域训练少量适应参数">
    <mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="900" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="C：冻结原共享基座，目标域训练少量适应参数" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="1300" height="27" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="三种额外适应模式独立选择；另设 none。全部模式都训练新的目标域输入适配器与任务头。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#475569;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1340" height="45" as="geometry" />
        </mxCell>
        <mxCell id="note" value="none 不增加上述三种适应模块，但仍训练目标输入适配器与任务头。LoRA 不修改原权重，关系映射及全部原参数保持冻结。&lt;br&gt;α = 0 为默认；α = 1 跳过共享前向。节点读根节点，图读完整小图；超限整图不被隐式裁剪。&lt;br&gt;按最低验证损失选模型，恢复后核验原共享参数哈希，再做一次最终测试。目标微调不上传目标标签。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="input" value="目标图／节点邻域&lt;br&gt;新私有输入适配器" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="experts" value="冻结欧式专家&lt;br&gt;H：N × M × d" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="280" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="prompt_slot" value="专家输出 H&lt;br&gt;prompt 模式：H + p" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="280" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="composer" value="冻结关系组合器&lt;br&gt;Z：N × d" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=14;arcSize=12;" vertex="1" parent="1">
